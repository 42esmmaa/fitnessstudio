# Vorlage fuer die lokale Datei .env mit den Passwoertern
#
# 1. Diese Datei nach .env kopieren:   Copy-Item .env.example .env
# 2. In .env eigene Passwoerter eintragen und im Team NICHT ueber GitHub austauschen
#
# .env steht in .gitignore und wird nie committet.
# Gelesen wird .env vom Appserver (python-dotenv) und von Docker Compose (env_file).

# Passwort des PostgreSQL-Superusers "postgres"
POSTGRES_PASSWORD=change-me

# Passwort des DB-Users "mitglied", mit dem der Appserver auf die DB zugreift
MITGLIED_DB_PASSWORD=change-me

# Passwort des DB-Users "keycloak" (PostgreSQL-Init-Skript und Keycloak-Container)
KC_DB_PASSWORD=change-me

# Passwort des temporaeren Keycloak-Administrators "tmp" (nur fuer die Admin-Konsole)
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Client Secret von "fitnessstudio-client" aus der Keycloak-Konsole
KEYCLOAK_CLIENT_SECRET=

# Administrativer Benutzer im Realm "fitnessstudio" fuer den Appserver.
# Dieser Benutzer ist NICHT der temporaere Administrator "tmp" im Realm "master".
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
